    "ds = (5,5,5); rs=(3,3,3)\n",
    "Γ = randn(Float64, ds);  # a control tensor\n",
    "\n",
    "# the experiment tensor is initially 0 but we fill in a subregion.\n",
    "Δ = zeros(Float64, ds);  \n",
    "Δ[1:rs[1], 1:rs[2], 1:rs[3]] .= randn(rs...)\n",
    "\n",
    "side_by_side(Γ, Δ; left_title=\"Control Γ\", right_title=\"Experiment Δ\")"
   ]
